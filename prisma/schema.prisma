// Mahalla Cluster — production schema (PostgreSQL / Supabase)
// Conventions:
//  - All status/role/type columns are Postgres enums.
//  - Money is Decimal(14,2) + Currency, never Float or free text.
//  - Every FK and every filter column is indexed.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL") // pooled (pgbouncer, port 6543) — runtime
  directUrl  = env("DIRECT_URL") // session (port 5432) — migrations
  extensions = [vector, pg_trgm]
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  admin
  factory_owner
  buyer
  worker
  service_provider
  user
}

enum Currency {
  EGP
  USD
  EUR
}

enum FactoryStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum MemberRole {
  OWNER
  MANAGER
  SALES
  VIEWER
}

enum ListingType {
  PRODUCT
  RESOURCE
  WASTE
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  FLAGGED
  ARCHIVED
}

enum JobStatus {
  ACTIVE
  CLOSED
  FLAGGED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  HIRED
}

enum RFQStatus {
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  DRAFT
  ACTIVE
  IN_PRODUCTION
  QC
  SHIPPED
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  RELEASED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYMOB
  STRIPE
  MANUAL
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_FACTORY
  CLOSED
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  CUSTOMS
  DELIVERED
  EXCEPTION
}

enum KycDocType {
  COMMERCIAL_REGISTER
  TAX_CARD
  NATIONAL_ID
  INDUSTRIAL_LICENSE
  OTHER
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

// ───────────────────────────── Identity ─────────────────────────────

/// Mirrors a Clerk user (id = Clerk user id). Synced on first request and via webhook.
model User {
  id        String    @id
  email     String    @unique
  firstName String?
  lastName  String?
  phone     String?
  imageUrl  String?
  locale    String    @default("ar")
  role      Role      @default(user)
  isBanned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  factories         Factory[]
  memberships       FactoryMember[]
  jobs              JobPosting[]
  listings          MarketplaceListing[]
  applications      JobApplication[]
  conversations     Conversation[]
  rfqs              RFQ[]
  reviews           Review[]
  contracts         Contract[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  favorites         Favorite[]
  disputesOpened    Dispute[]
  kycReviews        KycDocument[]            @relation("KycReviewer")

  @@index([role])
}

// ───────────────────────────── Factories ─────────────────────────────

model Factory {
  id                    String           @id @default(cuid())
  slug                  String?          @unique
  name                  String
  description           String?
  address               String
  city                  String           @default("El Mahalla El Kubra")
  latitude              Float?
  longitude             Float?
  phone                 String?
  website               String?
  logoUrl               String?
  coverUrl              String?
  taxRegistrationNumber String           @unique
  commercialRegister    String?
  employeesCount        Int?
  foundedYear           Int?
  monthlyCapacity       Int? // units per month
  capacityUnit          String? // "meters", "kg", "pieces"
  minOrderQty           Int?
  leadTimeDays          Int?
  capabilities          String[] // e.g. ["spinning","weaving","dyeing"]
  exportMarkets         String[] // ISO country codes
  status                FactoryStatus    @default(PENDING)
  subscriptionTier      SubscriptionTier @default(FREE)
  rejectionReason       String?
  isVerified            Boolean          @default(false)
  verifiedAt            DateTime?
  ownerId               String
  owner                 User             @relation(fields: [ownerId], references: [id])

  members        FactoryMember[]
  certifications Certification[]
  kycDocuments   KycDocument[]
  conversations  Conversation[]
  quotations     Quotation[]
  reviews        Review[]
  contracts      Contract[]
  subscription   Subscription?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([status, isVerified])
}

/// Team access to a factory account (owner, sales staff, etc.)
model FactoryMember {
  id        String     @id @default(cuid())
  factoryId String
  factory   Factory    @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole @default(SALES)
  createdAt DateTime   @default(now())

  @@unique([factoryId, userId])
  @@index([userId])
}

model Certification {
  id         String    @id @default(cuid())
  factoryId  String
  factory    Factory   @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  name       String // "GOTS", "OEKO-TEX Standard 100", "ISO 9001"
  issuer     String?
  number     String?
  fileUrl    String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([factoryId])
  @@index([name])
}

model KycDocument {
  id         String     @id @default(cuid())
  factoryId  String
  factory    Factory    @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  type       KycDocType
  fileUrl    String // Supabase Storage path (private bucket)
  status     KycStatus  @default(PENDING)
  reviewNote String?
  reviewerId String?
  reviewer   User?      @relation("KycReviewer", fields: [reviewerId], references: [id])
  reviewedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([factoryId])
  @@index([status])
}

model Subscription {
  id                 String           @id @default(cuid())
  factoryId          String           @unique
  factory            Factory          @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  tier               SubscriptionTier @default(FREE)
  provider           PaymentProvider?
  providerRef        String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

// ───────────────────────────── Marketplace ─────────────────────────────

model Category {
  id       String               @id @default(cuid())
  slug     String               @unique
  nameEn   String
  nameAr   String
  type     ListingType
  parentId String?
  parent   Category?            @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]           @relation("CategoryTree")
  listings MarketplaceListing[]

  @@index([type])
}

model MarketplaceListing {
  id            String           @id @default(cuid())
  title         String
  titleAr       String?
  description   String
  descriptionAr String?
  type          ListingType
  status        ListingStatus    @default(ACTIVE)
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  price         Decimal?         @db.Decimal(14, 2)
  currency      Currency         @default(USD)
  unit          String? // "meter", "kg", "piece", "hour"
  minOrderQty   Int?
  stockQty      Int?
  incoterm      String? // "FOB", "EXW", "CIF"
  attributes    Json? // type-specific: { gsm, composition, widthCm, color } | { machine } | { grade }
  viewCount     Int              @default(0)
  sellerId      String
  seller        User             @relation(fields: [sellerId], references: [id])
  media         ListingMedia[]
  passport      ProductPassport?
  favorites     Favorite[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@index([type, status])
  @@index([sellerId])
  @@index([categoryId])
  @@index([createdAt])
}

model ListingMedia {
  id        String             @id @default(cuid())
  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int                @default(0)
  createdAt DateTime           @default(now())

  @@index([listingId, position])
}

model Favorite {
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@id([userId, listingId])
}

/// Digital Product Passport (EU ESPR-aligned fields)
model ProductPassport {
  id               String             @id @default(cuid())
  listingId        String             @unique
  listing          MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  origin           String             @default("Mahalla El Kubra, Egypt")
  material         String
  fiberOrigin      String?
  carbonFootprint  String?
  waterUsage       String?
  certifications   String?
  supplyChain      Json? // [{ step, actor, location, date }]
  careInstructions String?
  recyclability    String?
  qrCodeUrl        String?
  signatureHash    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// ───────────────────────────── Sourcing ─────────────────────────────

model RFQ {
  id              String      @id @default(cuid())
  title           String
  description     String
  quantity        Int
  unit            String      @default("piece")
  targetPrice     Decimal?    @db.Decimal(14, 2)
  currency        Currency    @default(USD)
  deadline        DateTime?
  deliveryCountry String?
  attachments     String[]
  status          RFQStatus   @default(OPEN)
  buyerId         String
  buyer           User        @relation(fields: [buyerId], references: [id])
  quotations      Quotation[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([buyerId])
}

model Quotation {
  id           String          @id @default(cuid())
  rfqId        String
  rfq          RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  factoryId    String
  factory      Factory         @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  unitPrice    Decimal         @db.Decimal(14, 2)
  currency     Currency        @default(USD)
  minOrderQty  Int?
  leadTimeDays Int?
  validUntil   DateTime?
  message      String
  status       QuotationStatus @default(PENDING)
  contract     Contract?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([rfqId, factoryId])
  @@index([factoryId])
}

// ───────────────────────────── Orders / Escrow ─────────────────────────────

model Contract {
  id                String         @id @default(cuid())
  title             String
  totalAmount       Decimal        @db.Decimal(14, 2)
  currency          Currency       @default(USD)
  status            ContractStatus @default(ACTIVE)
  terms             String?
  incoterm          String?
  quotationId       String?        @unique
  quotation         Quotation?     @relation(fields: [quotationId], references: [id])
  buyerId           String
  buyer             User           @relation(fields: [buyerId], references: [id])
  factoryId         String
  factory           Factory        @relation(fields: [factoryId], references: [id])
  buyerAcceptedAt   DateTime?
  factoryAcceptedAt DateTime?
  milestones        Milestone[]
  shipments         Shipment[]
  disputes          Dispute[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([buyerId])
  @@index([factoryId])
  @@index([status])
}

model Milestone {
  id         String          @id @default(cuid())
  contractId String
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title      String
  amount     Decimal         @db.Decimal(14, 2)
  dueDate    DateTime?
  status     MilestoneStatus @default(PENDING)
  releasedAt DateTime?
  payments   Payment[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([contractId])
}

model Payment {
  id          String          @id @default(cuid())
  milestoneId String
  milestone   Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  provider    PaymentProvider
  providerRef String?         @unique
  amount      Decimal         @db.Decimal(14, 2)
  currency    Currency
  status      PaymentStatus   @default(PENDING)
  raw         Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([milestoneId])
}

model Shipment {
  id          String         @id @default(cuid())
  contractId  String
  contract    Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  carrier     String?
  trackingNo  String?
  origin      String?
  destination String?
  status      ShipmentStatus @default(PENDING)
  eta         DateTime?
  events      Json? // [{ at, status, location, note }]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([contractId])
}

model Dispute {
  id         String        @id @default(cuid())
  contractId String
  contract   Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  openedById String
  openedBy   User          @relation(fields: [openedById], references: [id])
  reason     String
  evidence   String[]
  status     DisputeStatus @default(OPEN)
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([contractId])
  @@index([status])
}

model Review {
  id         String   @id @default(cuid())
  rating     Int // 1..5 (enforced in validation)
  comment    String?
  factoryId  String
  factory    Factory  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([factoryId, reviewerId])
  @@index([factoryId])
}

// ───────────────────────────── Recruitment ─────────────────────────────

model JobPosting {
  id             String           @id @default(cuid())
  title          String
  description    String
  location       String?          @default("El Mahalla El Kubra")
  employmentType String? // "full_time", "part_time", "contract"
  salaryMin      Decimal?         @db.Decimal(12, 2)
  salaryMax      Decimal?         @db.Decimal(12, 2)
  skills         String[]
  status         JobStatus        @default(ACTIVE)
  employerId     String
  employer       User             @relation(fields: [employerId], references: [id])
  applications   JobApplication[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([employerId])
}

model JobApplication {
  id          String            @id @default(cuid())
  jobId       String
  job         JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User              @relation(fields: [applicantId], references: [id])
  coverLetter String?
  contactInfo String?
  cvUrl       String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, applicantId])
  @@index([applicantId])
}

// ───────────────────────────── Messaging & Notifications ─────────────────────────────

model Conversation {
  id            String    @id @default(cuid())
  listingId     String?
  rfqId         String?
  contractId    String?
  buyerId       String
  factoryId     String
  buyer         User      @relation(fields: [buyerId], references: [id])
  factory       Factory   @relation(fields: [factoryId], references: [id])
  messages      Message[]
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([buyerId, lastMessageAt])
  @@index([factoryId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  content        String
  attachments    String[]
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model NotificationPreference {
  userId  String
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel
  event   String // "rfq.new", "quote.received", "message.new", "contract.update"
  enabled Boolean             @default(true)

  @@id([userId, channel, event])
}

// ───────────────────────────── AI Knowledge Base (pgvector) ─────────────────────────────

model Document {
  id        String          @id @default(cuid())
  title     String
  source    String? // "google_drive", "upload", "url"
  sourceRef String?
  language  String?
  chunks    DocumentChunk[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position   Int
  content    String
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())

  @@index([documentId])
}

// ───────────────────────────── Platform ─────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entityId  String
  entity    String
  adminId   String
  details   String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
