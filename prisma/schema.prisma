// Mahalla Cluster — production schema (PostgreSQL / Supabase)
// Conventions:
//  - All status/role/type columns are Postgres enums.
//  - Money is Decimal(14,2) + Currency, never Float or free text.
//  - Every FK and every filter column is indexed.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL") // pooled (pgbouncer, port 6543) — runtime
  directUrl  = env("DIRECT_URL") // session (port 5432) — migrations
  extensions = [vector, pg_trgm]
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  admin
  factory_owner
  buyer
  worker
  service_provider
  user
}

enum Currency {
  EGP
  USD
  EUR
}

enum FactoryStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum MemberRole {
  OWNER
  MANAGER
  SALES
  VIEWER
}

enum ListingType {
  PRODUCT
  RESOURCE
  WASTE
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  FLAGGED
  ARCHIVED
}

enum JobStatus {
  ACTIVE
  CLOSED
  FLAGGED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  HIRED
}

enum RFQStatus {
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  DRAFT
  ACTIVE
  IN_PRODUCTION
  QC
  SHIPPED
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  RELEASED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYMOB
  STRIPE
  MANUAL
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_FACTORY
  CLOSED
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  CUSTOMS
  DELIVERED
  EXCEPTION
}

enum KycDocType {
  COMMERCIAL_REGISTER
  TAX_CARD
  NATIONAL_ID
  INDUSTRIAL_LICENSE
  OTHER
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

// ───────────────────────────── Identity ─────────────────────────────

/// Mirrors a Clerk user (id = Clerk user id). Synced on first request and via webhook.
model User {
  id        String    @id
  email     String    @unique
  firstName String?
  lastName  String?
  phone     String?
  imageUrl  String?
  locale    String    @default("ar")
  role      Role      @default(user)
  isBanned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  factories         Factory[]
  memberships       FactoryMember[]
  jobs              JobPosting[]
  listings          MarketplaceListing[]
  applications      JobApplication[]
  conversations     Conversation[]
  rfqs              RFQ[]
  reviews           Review[]
  contracts         Contract[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  favorites         Favorite[]
  disputesOpened    Dispute[]
  kycReviews        KycDocument[]            @relation("KycReviewer")

  // Cluster collaboration & modernization
  poolsOrganized     ProcurementPool[]
  facilityBookings   FacilityBooking[]
  assessmentsTaken   MaturityAssessment[]
  enrollments        Enrollment[]
  forumThreads       ForumThread[]
  forumPosts         ForumPost[]
  eventsOrganized    ClusterEvent[]
  eventRegistrations EventRegistration[]
  expertProfile      ExpertProfile?
  mentorshipRequests MentorshipRequest[]
  announcements      Announcement[]

  @@index([role])
}

// ───────────────────────────── Factories ─────────────────────────────

model Factory {
  id                    String           @id @default(cuid())
  slug                  String?          @unique
  name                  String
  description           String?
  address               String
  city                  String           @default("El Mahalla El Kubra")
  latitude              Float?
  longitude             Float?
  phone                 String?
  website               String?
  logoUrl               String?
  coverUrl              String?
  taxRegistrationNumber String           @unique
  commercialRegister    String?
  employeesCount        Int?
  foundedYear           Int?
  monthlyCapacity       Int? // units per month
  capacityUnit          String? // "meters", "kg", "pieces"
  minOrderQty           Int?
  leadTimeDays          Int?
  capabilities          String[] // e.g. ["spinning","weaving","dyeing"]
  exportMarkets         String[] // ISO country codes
  status                FactoryStatus    @default(PENDING)
  subscriptionTier      SubscriptionTier @default(FREE)
  rejectionReason       String?
  isVerified            Boolean          @default(false)
  verifiedAt            DateTime?
  ownerId               String
  owner                 User             @relation(fields: [ownerId], references: [id])

  members        FactoryMember[]
  certifications Certification[]
  kycDocuments   KycDocument[]
  conversations  Conversation[]
  quotations     Quotation[]
  reviews        Review[]
  contracts      Contract[]
  subscription   Subscription?

  // Cluster collaboration & modernization
  poolCommitments     PoolCommitment[]
  capacityPosts       CapacityPost[]
  capacityResponses   CapacityResponse[]
  consortiaLed        Consortium[]
  consortiumSeats     ConsortiumMember[]
  facilityBookings    FacilityBooking[]
  assessments         MaturityAssessment[]
  sustainability      SustainabilityRecord[]
  fundingApplications FundingApplication[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([status, isVerified])
}

/// Team access to a factory account (owner, sales staff, etc.)
model FactoryMember {
  id        String     @id @default(cuid())
  factoryId String
  factory   Factory    @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole @default(SALES)
  createdAt DateTime   @default(now())

  @@unique([factoryId, userId])
  @@index([userId])
}

model Certification {
  id         String    @id @default(cuid())
  factoryId  String
  factory    Factory   @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  name       String // "GOTS", "OEKO-TEX Standard 100", "ISO 9001"
  issuer     String?
  number     String?
  fileUrl    String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  isVerified Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([factoryId])
  @@index([name])
}

model KycDocument {
  id         String     @id @default(cuid())
  factoryId  String
  factory    Factory    @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  type       KycDocType
  fileUrl    String // Supabase Storage path (private bucket)
  status     KycStatus  @default(PENDING)
  reviewNote String?
  reviewerId String?
  reviewer   User?      @relation("KycReviewer", fields: [reviewerId], references: [id])
  reviewedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([factoryId])
  @@index([status])
}

model Subscription {
  id                 String           @id @default(cuid())
  factoryId          String           @unique
  factory            Factory          @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  tier               SubscriptionTier @default(FREE)
  provider           PaymentProvider?
  providerRef        String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

// ───────────────────────────── Marketplace ─────────────────────────────

model Category {
  id       String               @id @default(cuid())
  slug     String               @unique
  nameEn   String
  nameAr   String
  type     ListingType
  parentId String?
  parent   Category?            @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]           @relation("CategoryTree")
  listings MarketplaceListing[]

  @@index([type])
}

model MarketplaceListing {
  id            String           @id @default(cuid())
  title         String
  titleAr       String?
  description   String
  descriptionAr String?
  type          ListingType
  status        ListingStatus    @default(ACTIVE)
  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id])
  price         Decimal?         @db.Decimal(14, 2)
  currency      Currency         @default(USD)
  unit          String? // "meter", "kg", "piece", "hour"
  minOrderQty   Int?
  stockQty      Int?
  incoterm      String? // "FOB", "EXW", "CIF"
  attributes    Json? // type-specific: { gsm, composition, widthCm, color } | { machine } | { grade }
  viewCount     Int              @default(0)
  sellerId      String
  seller        User             @relation(fields: [sellerId], references: [id])
  media         ListingMedia[]
  passport      ProductPassport?
  favorites     Favorite[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@index([type, status])
  @@index([sellerId])
  @@index([categoryId])
  @@index([createdAt])
}

model ListingMedia {
  id        String             @id @default(cuid())
  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int                @default(0)
  createdAt DateTime           @default(now())

  @@index([listingId, position])
}

model Favorite {
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@id([userId, listingId])
}

/// Digital Product Passport (EU ESPR-aligned fields)
model ProductPassport {
  id               String             @id @default(cuid())
  listingId        String             @unique
  listing          MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  origin           String             @default("Mahalla El Kubra, Egypt")
  material         String
  fiberOrigin      String?
  carbonFootprint  String?
  waterUsage       String?
  certifications   String?
  supplyChain      Json? // [{ step, actor, location, date }]
  careInstructions String?
  recyclability    String?
  qrCodeUrl        String?
  signatureHash    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// ───────────────────────────── Sourcing ─────────────────────────────

model RFQ {
  id              String       @id @default(cuid())
  title           String
  description     String
  quantity        Int
  unit            String       @default("piece")
  targetPrice     Decimal?     @db.Decimal(14, 2)
  currency        Currency     @default(USD)
  deadline        DateTime?
  deliveryCountry String?
  attachments     String[]
  status          RFQStatus    @default(OPEN)
  buyerId         String
  buyer           User         @relation(fields: [buyerId], references: [id])
  quotations      Quotation[]
  consortia       Consortium[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([buyerId])
}

model Quotation {
  id           String          @id @default(cuid())
  rfqId        String
  rfq          RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  factoryId    String
  factory      Factory         @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  unitPrice    Decimal         @db.Decimal(14, 2)
  currency     Currency        @default(USD)
  minOrderQty  Int?
  leadTimeDays Int?
  validUntil   DateTime?
  message      String
  status       QuotationStatus @default(PENDING)
  contract     Contract?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([rfqId, factoryId])
  @@index([factoryId])
}

// ───────────────────────────── Orders / Escrow ─────────────────────────────

model Contract {
  id                String         @id @default(cuid())
  title             String
  totalAmount       Decimal        @db.Decimal(14, 2)
  currency          Currency       @default(USD)
  status            ContractStatus @default(ACTIVE)
  terms             String?
  incoterm          String?
  quotationId       String?        @unique
  quotation         Quotation?     @relation(fields: [quotationId], references: [id])
  buyerId           String
  buyer             User           @relation(fields: [buyerId], references: [id])
  factoryId         String
  factory           Factory        @relation(fields: [factoryId], references: [id])
  buyerAcceptedAt   DateTime?
  factoryAcceptedAt DateTime?
  milestones        Milestone[]
  shipments         Shipment[]
  disputes          Dispute[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([buyerId])
  @@index([factoryId])
  @@index([status])
}

model Milestone {
  id         String          @id @default(cuid())
  contractId String
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title      String
  amount     Decimal         @db.Decimal(14, 2)
  dueDate    DateTime?
  status     MilestoneStatus @default(PENDING)
  releasedAt DateTime?
  payments   Payment[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([contractId])
}

model Payment {
  id          String          @id @default(cuid())
  milestoneId String
  milestone   Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  provider    PaymentProvider
  providerRef String?         @unique
  amount      Decimal         @db.Decimal(14, 2)
  currency    Currency
  status      PaymentStatus   @default(PENDING)
  raw         Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([milestoneId])
}

model Shipment {
  id          String         @id @default(cuid())
  contractId  String
  contract    Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  carrier     String?
  trackingNo  String?
  origin      String?
  destination String?
  status      ShipmentStatus @default(PENDING)
  eta         DateTime?
  events      Json? // [{ at, status, location, note }]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([contractId])
}

model Dispute {
  id         String        @id @default(cuid())
  contractId String
  contract   Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  openedById String
  openedBy   User          @relation(fields: [openedById], references: [id])
  reason     String
  evidence   String[]
  status     DisputeStatus @default(OPEN)
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([contractId])
  @@index([status])
}

model Review {
  id         String   @id @default(cuid())
  rating     Int // 1..5 (enforced in validation)
  comment    String?
  factoryId  String
  factory    Factory  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([factoryId, reviewerId])
  @@index([factoryId])
}

// ───────────────────────────── Recruitment ─────────────────────────────

model JobPosting {
  id             String           @id @default(cuid())
  title          String
  description    String
  location       String?          @default("El Mahalla El Kubra")
  employmentType String? // "full_time", "part_time", "contract"
  salaryMin      Decimal?         @db.Decimal(12, 2)
  salaryMax      Decimal?         @db.Decimal(12, 2)
  skills         String[]
  status         JobStatus        @default(ACTIVE)
  employerId     String
  employer       User             @relation(fields: [employerId], references: [id])
  applications   JobApplication[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([employerId])
}

model JobApplication {
  id          String            @id @default(cuid())
  jobId       String
  job         JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User              @relation(fields: [applicantId], references: [id])
  coverLetter String?
  contactInfo String?
  cvUrl       String?
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([jobId, applicantId])
  @@index([applicantId])
}

// ───────────────────────────── Messaging & Notifications ─────────────────────────────

model Conversation {
  id            String    @id @default(cuid())
  listingId     String?
  rfqId         String?
  contractId    String?
  buyerId       String
  factoryId     String
  buyer         User      @relation(fields: [buyerId], references: [id])
  factory       Factory   @relation(fields: [factoryId], references: [id])
  messages      Message[]
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([buyerId, lastMessageAt])
  @@index([factoryId, lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  content        String
  attachments    String[]
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model NotificationPreference {
  userId  String
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel NotificationChannel
  event   String // "rfq.new", "quote.received", "message.new", "contract.update"
  enabled Boolean             @default(true)

  @@id([userId, channel, event])
}

// ───────────────────────────── AI Knowledge Base (pgvector) ─────────────────────────────

model Document {
  id        String          @id @default(cuid())
  title     String
  source    String? // "google_drive", "upload", "url"
  sourceRef String?
  language  String?
  chunks    DocumentChunk[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position   Int
  content    String
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime                    @default(now())

  @@index([documentId])
}

// ───────────────────────────── Platform ─────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entityId  String
  entity    String
  adminId   String
  details   String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ═════════════════════════════════════════════════════════════════════════════
//  CLUSTER COLLABORATION & MODERNIZATION
//  Modules: C1 Joint Procurement · C2 Capacity Exchange · C3 Consortia
//           C4 Shared Facilities · M1 Digital Maturity · M2 Academy
//           M3 Sustainability/ESG · M4 Funding Hub · K1 Forum · K2 Events
//           K3 Experts & Mentorship · K4 Announcements
// ═════════════════════════════════════════════════════════════════════════════

enum ProcurementCategory {
  YARN
  FIBER
  DYES_CHEMICALS
  SPARE_PARTS
  PACKAGING
  ENERGY
  LOGISTICS
  OTHER
}

enum PoolStatus {
  OPEN
  NEGOTIATING
  ORDERED
  DELIVERED
  CLOSED
  CANCELLED
}

enum CommitmentStatus {
  COMMITTED
  CONFIRMED
  WITHDRAWN
}

enum CapacityKind {
  OFFER // "I have idle capacity"
  REQUEST // "I need a subcontractor"
}

enum CapacityStatus {
  OPEN
  MATCHED
  CLOSED
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ConsortiumStatus {
  FORMING
  BIDDING
  ACTIVE
  CLOSED
}

enum SeatStatus {
  INVITED
  ACCEPTED
  DECLINED
}

enum FacilityType {
  TESTING_LAB
  CAD_DESIGN
  DYEHOUSE
  EFFLUENT_TREATMENT
  TRAINING_CENTER
  WAREHOUSE
  SHOWROOM
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum CourseCategory {
  TECHNICAL
  QUALITY
  DIGITAL
  SUSTAINABILITY
  EXPORT
  MANAGEMENT
  SAFETY
}

enum EnrollmentStatus {
  ENROLLED
  COMPLETED
}

enum FundingType {
  GRANT
  LOAN
  TECHNICAL_ASSISTANCE
  SUBSIDY
  EQUITY
}

enum FundingAppStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ForumCategory {
  GENERAL
  TECHNICAL
  MARKET
  POLICY
  SUSTAINABILITY
  JOBS
}

enum EventType {
  WORKSHOP
  TRADE_FAIR
  B2B_MEETING
  TRAINING
  WEBINAR
  NETWORKING
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

enum MentorshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum Audience {
  ALL
  FACTORIES
  BUYERS
  WORKERS
}

// ── C1. Joint procurement (group buying of yarn, dyes, energy…) ──────────────

model ProcurementPool {
  id                  String              @id @default(cuid())
  title               String
  titleAr             String?
  description         String
  category            ProcurementCategory
  specification       String? // e.g. "Ne 30/1 combed cotton, Giza 86"
  unit                String              @default("kg")
  targetQty           Int // volume needed to unlock the negotiated price
  minCommitQty        Int                 @default(1)
  benchmarkUnitPrice  Decimal?            @db.Decimal(14, 2) // what a single SME pays alone
  targetUnitPrice     Decimal?            @db.Decimal(14, 2)
  negotiatedUnitPrice Decimal?            @db.Decimal(14, 2)
  currency            Currency            @default(EGP)
  supplierName        String?
  deadline            DateTime
  status              PoolStatus          @default(OPEN)
  organizerId         String
  organizer           User                @relation(fields: [organizerId], references: [id])
  commitments         PoolCommitment[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, deadline])
  @@index([category])
}

model PoolCommitment {
  id        String           @id @default(cuid())
  poolId    String
  pool      ProcurementPool  @relation(fields: [poolId], references: [id], onDelete: Cascade)
  factoryId String
  factory   Factory          @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  quantity  Int
  note      String?
  status    CommitmentStatus @default(COMMITTED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([poolId, factoryId])
  @@index([factoryId])
}

// ── C2. Capacity exchange (idle capacity ↔ subcontracting needs) ─────────────

model CapacityPost {
  id            String             @id @default(cuid())
  kind          CapacityKind
  process       String // capability key: "spinning","weaving","knitting","dyeing","printing","finishing","sewing","embroidery"
  title         String
  description   String
  quantity      Int
  unit          String             @default("meters")
  availableFrom DateTime
  availableTo   DateTime?
  unitPrice     Decimal?           @db.Decimal(14, 2)
  currency      Currency           @default(EGP)
  status        CapacityStatus     @default(OPEN)
  factoryId     String
  factory       Factory            @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  responses     CapacityResponse[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([kind, status, process])
  @@index([factoryId])
}

model CapacityResponse {
  id        String         @id @default(cuid())
  postId    String
  post      CapacityPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  factoryId String
  factory   Factory        @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  quantity  Int?
  unitPrice Decimal?       @db.Decimal(14, 2)
  message   String
  status    ResponseStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([postId, factoryId])
  @@index([factoryId])
}

// ── C3. Consortia (SMEs bid jointly on orders too large for one factory) ─────

model Consortium {
  id            String             @id @default(cuid())
  name          String
  description   String
  targetMarket  String?
  status        ConsortiumStatus   @default(FORMING)
  leadFactoryId String
  leadFactory   Factory            @relation(fields: [leadFactoryId], references: [id])
  rfqId         String?
  rfq           RFQ?               @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  members       ConsortiumMember[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status])
  @@index([leadFactoryId])
  @@index([rfqId])
}

model ConsortiumMember {
  id           String     @id @default(cuid())
  consortiumId String
  consortium   Consortium @relation(fields: [consortiumId], references: [id], onDelete: Cascade)
  factoryId    String
  factory      Factory    @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  role         String // value-chain step contributed: "spinning","weaving","dyeing","sewing"
  sharePct     Decimal?   @db.Decimal(5, 2)
  status       SeatStatus @default(INVITED)
  createdAt    DateTime   @default(now())

  @@unique([consortiumId, factoryId])
  @@index([factoryId])
}

// ── C4. Shared facilities (labs, CAD, effluent treatment, training rooms) ───

model SharedFacility {
  id          String            @id @default(cuid())
  name        String
  nameAr      String?
  type        FacilityType
  description String
  location    String
  operator    String?
  equipment   String[]
  ratePerHour Decimal?          @db.Decimal(12, 2)
  currency    Currency          @default(EGP)
  imageUrl    String?
  isActive    Boolean           @default(true)
  bookings    FacilityBooking[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([type, isActive])
}

model FacilityBooking {
  id         String         @id @default(cuid())
  facilityId String
  facility   SharedFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  factoryId  String?
  factory    Factory?       @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  startAt    DateTime
  endAt      DateTime
  purpose    String
  status     BookingStatus  @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([facilityId, startAt])
  @@index([userId])
}

// ── M1. Digital maturity / Industry 4.0 readiness ───────────────────────────

model MaturityAssessment {
  id              String   @id @default(cuid())
  factoryId       String
  factory         Factory  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  takenById       String
  takenBy         User     @relation(fields: [takenById], references: [id])
  answers         Json // { [questionId]: 0..4 }
  scores          Json // { digital, production, quality, sustainability, market, people } each 0..100
  overallScore    Int // 0..100
  level           Int // 1..5
  recommendations Json // [{ dimension, priority, action, actionAr, programHint }]
  createdAt       DateTime @default(now())

  @@index([factoryId, createdAt])
}

// ── M2. Cluster Academy (upskilling workers & managers) ─────────────────────

model Course {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  titleAr       String
  description   String
  descriptionAr String
  category      CourseCategory
  level         String         @default("beginner") // beginner | intermediate | advanced
  durationHours Int
  provider      String // "TIGARA / UNIDO", "Cluster Academy", "ITC"
  coverUrl      String?
  isPublished   Boolean        @default(true)
  lessons       Lesson[]
  enrollments   Enrollment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([category, isPublished])
}

model Lesson {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  titleAr     String?
  content     String // markdown
  videoUrl    String?
  durationMin Int     @default(10)

  @@unique([courseId, position])
}

model Enrollment {
  id               String           @id @default(cuid())
  courseId         String
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedLessons String[]
  progress         Int              @default(0) // 0..100
  status           EnrollmentStatus @default(ENROLLED)
  certificateCode  String?          @unique
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([courseId, userId])
  @@index([userId])
}

// ── M3. Sustainability / ESG / CBAM readiness ───────────────────────────────

model SustainabilityRecord {
  id              String   @id @default(cuid())
  factoryId       String
  factory         Factory  @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  period          DateTime // first day of the month (UTC)
  electricityKwh  Decimal  @default(0) @db.Decimal(14, 2)
  solarKwh        Decimal  @default(0) @db.Decimal(14, 2)
  naturalGasM3    Decimal  @default(0) @db.Decimal(14, 2)
  dieselLiters    Decimal  @default(0) @db.Decimal(14, 2)
  waterM3         Decimal  @default(0) @db.Decimal(14, 2)
  recycledWaterM3 Decimal  @default(0) @db.Decimal(14, 2)
  chemicalsKg     Decimal  @default(0) @db.Decimal(14, 2)
  wasteKg         Decimal  @default(0) @db.Decimal(14, 2)
  recycledWasteKg Decimal  @default(0) @db.Decimal(14, 2)
  productionKg    Decimal  @default(0) @db.Decimal(14, 2)
  co2eKg          Decimal  @default(0) @db.Decimal(14, 2) // computed server-side (scope 1 + 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([factoryId, period])
  @@index([period])
}

// ── M4. Funding & grants hub ────────────────────────────────────────────────

model FundingProgram {
  id            String               @id @default(cuid())
  title         String
  titleAr       String
  provider      String // "EU / UNIDO (TIGARA)", "MSMEDA", "IMC", "EBRD", "GIZ", "CBE initiative"
  type          FundingType
  description   String
  descriptionAr String?
  eligibility   String
  maxAmount     Decimal?             @db.Decimal(14, 2)
  currency      Currency             @default(EGP)
  deadline      DateTime?
  url           String?
  tags          String[] // matches maturity dimensions: "digital","sustainability","export","people"
  isActive      Boolean              @default(true)
  applications  FundingApplication[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([isActive, deadline])
}

model FundingApplication {
  id              String           @id @default(cuid())
  programId       String
  program         FundingProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  factoryId       String
  factory         Factory          @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  amountRequested Decimal?         @db.Decimal(14, 2)
  purpose         String
  status          FundingAppStatus @default(SUBMITTED)
  reviewNote      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([programId, factoryId])
  @@index([factoryId])
  @@index([status])
}

// ── K1. Community forum / Q&A ────────────────────────────────────────────────

model ForumThread {
  id             String        @id @default(cuid())
  title          String
  body           String
  category       ForumCategory @default(GENERAL)
  tags           String[]
  isPinned       Boolean       @default(false)
  isLocked       Boolean       @default(false)
  viewCount      Int           @default(0)
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  posts          ForumPost[]
  lastActivityAt DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([category, lastActivityAt])
  @@index([isPinned, lastActivityAt])
}

model ForumPost {
  id         String      @id @default(cuid())
  threadId   String
  thread     ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId   String
  author     User        @relation(fields: [authorId], references: [id])
  body       String
  isAccepted Boolean     @default(false)
  createdAt  DateTime    @default(now())
  deletedAt  DateTime?

  @@index([threadId, createdAt])
}

// ── K2. Cluster events (workshops, trade fairs, B2B meetings) ───────────────

model ClusterEvent {
  id            String              @id @default(cuid())
  title         String
  titleAr       String?
  description   String
  type          EventType
  startsAt      DateTime
  endsAt        DateTime?
  location      String?
  onlineUrl     String?
  capacity      Int?
  organizerId   String
  organizer     User                @relation(fields: [organizerId], references: [id])
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([startsAt])
  @@index([type])
}

model EventRegistration {
  id        String             @id @default(cuid())
  eventId   String
  event     ClusterEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    RegistrationStatus @default(REGISTERED)
  createdAt DateTime           @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

// ── K3. Experts & mentorship ────────────────────────────────────────────────

model ExpertProfile {
  id          String              @id @default(cuid())
  userId      String              @unique
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  headline    String
  bio         String
  expertise   String[] // "lean manufacturing","dyeing chemistry","EU export","ERP"
  languages   String[]
  yearsExp    Int?
  hourlyRate  Decimal?            @db.Decimal(12, 2)
  currency    Currency            @default(EGP)
  isMentor    Boolean             @default(true) // offers free mentorship hours to cluster SMEs
  isVerified  Boolean             @default(false)
  requests    MentorshipRequest[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([isMentor, isVerified])
}

model MentorshipRequest {
  id          String           @id @default(cuid())
  expertId    String
  expert      ExpertProfile    @relation(fields: [expertId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User             @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  topic       String
  message     String
  preferredAt DateTime?
  status      MentorshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([expertId, status])
  @@index([requesterId])
}

// ── K4. Cluster announcements (CMO → members) ───────────────────────────────

model Announcement {
  id          String    @id @default(cuid())
  title       String
  titleAr     String?
  body        String
  bodyAr      String?
  audience    Audience  @default(ALL)
  isPinned    Boolean   @default(false)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?

  @@index([audience, publishedAt])
}
